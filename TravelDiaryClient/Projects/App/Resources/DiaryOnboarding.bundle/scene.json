5","kind":"text","locked":false,"name":"左页引题","semanticKind":"text","size":[1660,99],"text":"山谷里的日子 · 随走随记","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[240,380],"rotationDegrees":0,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":76,"id":"A2C1369B-FB3D-46C4-BE61-788A6ABD6A9C","kind":"text","locked":false,"name":"左页手写旁白","semanticKind":"text","size":[630,114],"text":"把脚步放慢，\n把山风记住。","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[1370,660],"rotationDegrees":3,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":61,"id":"3A59DB5A-14CB-4AF8-B4A4-7DBFEA7605DE","kind":"text","locked":false,"name":"左页照片旁注","semanticKind":"text","size":[650,91.5],"text":"在山野里\n伸个懒腰","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.25,"red":0.32},"transform":{"pivot":[0,0],"position":[1310,1010],"rotationDegrees":-3,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":62,"id":"D2B72781-EB39-41EF-8EAB-9537B5DA1389","kind":"text","locked":false,"name":"左页照片说明","semanticKind":"text","size":[1600,93],"text":"坐一会儿，看看水，也看看远山。","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[310,2915],"rotationDegrees":-2,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.ma-shan-zheng","version":"2.003"},"fontSize":137,"id":"6ABEAC4F-AA60-4274-9D99-D6CDAE22B032","kind":"text","locked":false,"name":"右页大标题","semanticKind":"text","size":[1690,205.5],"text":"把这一刻留下","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[2450,160],"rotationDegrees":2,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":65,"id":"BDAFF6B7-23D8-4B1A-AD9E-258D0EDC0100","kind":"text","locked":false,"name":"右页引题","semanticKind":"text","size":[1600,97.5],"text":"风景很远，同行的人很近。","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[2460,385],"rotationDegrees":0,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":64,"id":"1E6F6B36-3D54-4628-85A3-9D334E0E0C34","kind":"text","locked":false,"name":"右页记事","semanticKind":"text","size":[1280,96],"text":"经幡在风里轻轻晃动。\n一抬头，山就在眼前。","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[2550,1700],"rotationDegrees":-2,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":69,"id":"F5A94061-4F16-468A-BA00-134EBCDD61EA","kind":"text","locked":false,"name":"同行照片旁注","semanticKind":"text","size":[1000,103.5],"text":"一起走过的路","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.23,"red":0.12},"transform":{"pivot":[0,0],"position":[2420,2810],"rotationDegrees":-3,"scale":1},"visible":true},{"crop":{"offset":[0,0],"zoom":1},"font":{"id":"calligraphy.long-cang","version":"2.001"},"fontSize":56,"id":"63AFF8D0-3A18-44D7-A80F-BA81FB47F68F","kind":"text","locked":false,"name":"右页结语","semanticKind":"text","size":[1680,84],"text":"把平凡的一天，留成喜欢的一页。","textAlignment":"left","textColor":{"alpha":1,"blue":0.19,"green":0.25,"red":0.32},"transform":{"pivot":[0,0],"position":[2470,2960],"rotationDegrees":0,"scale":1},"visible":true}],"referenceSize":[4370,3130],"revision":46,"role":"canvas"},{"id":"C78DFBD8-6F76-4B7F-A983-34D55D0331A7","layers":[{"assetID":"2EC02100-EE14-4BD4-6363-477F25A86208","crop":{"offset":[0,0],"zoom":1},"fontSize":36,"id":"40A0F6DE-49E8